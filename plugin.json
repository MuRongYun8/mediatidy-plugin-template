{
  "id": "official.ai-organize",
  "name": "AI 识别整理",
  "version": "1.1.1",
  "sdkVersion": "1",
  "description": "插件 AI 直接判断作品与季集，独立保留识别结果；匹配并核验 TMDB 条目后生成待确认草稿。文件名、相对路径和补充说明会发送至 MT 配置的模型服务。",
  "author": "MediaTidy",
  "entry": "dist/index.js",
  "permissions": [
    "files.read",
    "ai.complete",
    "tmdb.read",
    "organize.prepare",
    "organize.submit",
    "tasks.read",
    "tasks.cancel"
  ],
  "config": [
    {
      "key": "extractionPrompt",
      "label": "AI 作品识别补充策略",
      "type": "textarea",
      "default": ""
    },
    {
      "key": "selectionPrompt",
      "label": "AI 条目匹配补充策略",
      "type": "textarea",
      "default": ""
    }
  ],
  "actions": [
    {
      "id": "recognize",
      "label": "识别并生成草稿",
      "fields": [
        {
          "key": "files",
          "label": "文件或目录（最多 100 个视频）",
          "type": "files",
          "required": true
        },
        {
          "key": "profileId",
          "label": "整理方案",
          "type": "profile",
          "required": true
        },
        {
          "key": "instructions",
          "label": "识别补充说明",
          "type": "textarea",
          "default": ""
        }
      ]
    }
  ],
  "columns": [
    {
      "key": "file",
      "label": "文件"
    },
    {
      "key": "status",
      "label": "识别结果"
    }
  ],
  "ui": {
    "version": "1",
    "entry": "ui/page.json",
    "icon": "ui/icon.png"
  }
}
