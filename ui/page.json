{
  "version": "1",
  "tabs": [
    {
      "id": "overview",
      "label": "使用说明",
      "content": [
        {
          "component": "Card",
          "props": {
            "title": "AI 识别，按结论整理",
            "description": "识别策略、提示词和页面均来自这个独立插件。"
          },
          "children": [
            {
              "component": "Text",
              "props": {
                "text": "把原始文件名、相对路径和补充说明交给 AI。AI 自己判断作品和季集，自己决定是否查询资料；识别信息完整后，直接调用 MT 手动整理。"
              }
            },
            {
              "component": "Stack",
              "props": {
                "direction": "row"
              },
              "children": [
                {
                  "component": "Badge",
                  "props": {
                    "text": "选择视频"
                  }
                },
                {
                  "component": "Badge",
                  "props": {
                    "text": "AI 自主识别"
                  }
                },
                {
                  "component": "Badge",
                  "props": {
                    "text": "MT 执行整理"
                  }
                }
              ]
            },
            {
              "component": "Text",
              "props": {
                "text": "开始前在 MT 配置 AI、TMDB 和整理方案，并为本插件授权目录及方案。直接整理遵循方案的移动、复制、覆盖和清理设置。",
                "tone": "muted",
                "size": "sm"
              }
            },
            {
              "component": "Text",
              "props": {
                "text": "每批最多 8 个文件，每次最多 100 个视频。AI 直接回答时，每批一次对话。缺少季数默认第一季，明确的第 0 季保留，集号不猜测。",
                "tone": "muted",
                "size": "sm"
              }
            },
            {
              "component": "Button",
              "props": {
                "label": "选择文件并开始",
                "action": "newRun"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "run",
      "label": "识别与整理",
      "content": [
        {
          "component": "Stack",
          "props": {
            "direction": "row"
          },
          "children": [
            {
              "component": "Button",
              "props": {
                "label": "新建整理",
                "action": "newRun"
              }
            },
            {
              "component": "Button",
              "props": {
                "label": "运行记录",
                "action": "openTab",
                "tab": "history",
                "variant": "outline"
              }
            },
            {
              "component": "Button",
              "props": {
                "label": "提示词与授权",
                "action": "openTab",
                "tab": "settings",
                "variant": "ghost"
              }
            }
          ]
        },
        {
          "component": "Grid",
          "props": {
            "columns": 2,
            "ratio": "wide-left",
            "gap": "lg"
          },
          "children": [
            {
              "component": "Card",
              "props": {
                "title": "要整理哪些视频",
                "description": "选择多个文件或目录。目录在 MT 后台扫描，超过 100 个视频时请分批。"
              },
              "children": [
                {
                  "component": "FilePicker"
                }
              ]
            },
            {
              "component": "Card",
              "props": {
                "title": "按哪个方案执行"
              },
              "children": [
                {
                  "component": "ProfilePicker",
                  "props": {
                    "label": "整理方案",
                    "bind": "input.profileId"
                  }
                },
                {
                  "component": "Textarea",
                  "props": {
                    "label": "给 AI 的补充说明（可留空）",
                    "bind": "input.instructions",
                    "placeholder": "直接告诉 AI 你知道的线索，无需填写搜索词或识别步骤。"
                  }
                },
                {
                  "component": "Alert",
                  "props": {
                    "text": "点击后会按 AI 结论直接整理，请先检查所选文件和方案。不会再进入 MT 识别或草稿确认。"
                  }
                },
                {
                  "component": "Button",
                  "props": {
                    "label": "AI 识别并整理",
                    "action": "start",
                    "actionId": "recognize"
                  },
                  "disabledWhen": {
                    "path": "ui.canStart",
                    "op": "falsy"
                  }
                },
                {
                  "component": "Text",
                  "props": {
                    "text": "仅发送文件名、相对路径和说明；联网工具是否可用取决于你的授权与服务设置。",
                    "tone": "muted",
                    "size": "sm"
                  }
                }
              ]
            }
          ],
          "visibleWhen": {
            "path": "ui.showNew",
            "op": "truthy"
          }
        },
        {
          "component": "Progress",
          "props": {
            "label": "当前进度",
            "bind": "run.progress.completed",
            "total": "run.progress.total"
          },
          "visibleWhen": {
            "path": "ui.working",
            "op": "truthy"
          }
        },
        {
          "component": "Alert",
          "props": {
            "bind": "run.error",
            "tone": "danger"
          },
          "visibleWhen": {
            "path": "run.error",
            "op": "truthy"
          }
        },
        {
          "component": "Alert",
          "props": {
            "bind": "ui.error",
            "tone": "danger"
          },
          "visibleWhen": {
            "path": "ui.error",
            "op": "truthy"
          }
        },
        {
          "component": "Card",
          "props": {
            "title": "本次识别与整理"
          },
          "children": [
            {
              "component": "Stack",
              "props": {
                "direction": "row"
              },
              "children": [
                {
                  "component": "Text",
                  "props": {
                    "text": "插件版本",
                    "tone": "muted",
                    "size": "sm"
                  }
                },
                {
                  "component": "Badge",
                  "props": {
                    "bind": "run.pluginVersion"
                  }
                },
                {
                  "component": "Status",
                  "props": {
                    "bind": "run.status"
                  }
                },
                {
                  "component": "Button",
                  "props": {
                    "label": "刷新状态",
                    "action": "refresh",
                    "variant": "outline"
                  }
                },
                {
                  "component": "Button",
                  "props": {
                    "label": "停止后续识别",
                    "action": "cancelRun",
                    "variant": "outline"
                  },
                  "visibleWhen": {
                    "path": "ui.working",
                    "op": "truthy"
                  }
                }
              ]
            },
            {
              "component": "Grid",
              "props": {
                "columns": 4,
                "gap": "sm"
              },
              "children": [
                {
                  "component": "Card",
                  "props": {
                    "title": "AI 对话"
                  },
                  "children": [
                    {
                      "component": "Text",
                      "props": {
                        "bind": "run.stats.dialogueRounds",
                        "size": "xl"
                      }
                    }
                  ]
                },
                {
                  "component": "Card",
                  "props": {
                    "title": "实际模型请求"
                  },
                  "children": [
                    {
                      "component": "Text",
                      "props": {
                        "bind": "run.stats.modelRequests",
                        "size": "xl"
                      }
                    }
                  ]
                },
                {
                  "component": "Card",
                  "props": {
                    "title": "联网 / TMDB"
                  },
                  "children": [
                    {
                      "component": "Stack",
                      "props": {
                        "direction": "row"
                      },
                      "children": [
                        {
                          "component": "Text",
                          "props": {
                            "bind": "run.stats.webQueries",
                            "size": "xl"
                          }
                        },
                        {
                          "component": "Text",
                          "props": {
                            "text": "/",
                            "tone": "muted",
                            "size": "sm"
                          }
                        },
                        {
                          "component": "Text",
                          "props": {
                            "bind": "run.stats.tmdbQueries",
                            "size": "xl"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "component": "Card",
                  "props": {
                    "title": "缓存命中"
                  },
                  "children": [
                    {
                      "component": "Text",
                      "props": {
                        "bind": "run.stats.cacheHits",
                        "size": "xl"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "component": "Text",
              "props": {
                "text": "请求统计未记录；目录扫描完成后开始识别。",
                "tone": "muted",
                "size": "sm"
              },
              "visibleWhen": {
                "path": "run.stats",
                "op": "falsy"
              }
            },
            {
              "component": "Text",
              "props": {
                "text": "查询资料后可能继续对话；实际请求包含兼容重发和原生联网。完整识别信息直接入队，未确定的文件留为待处理。",
                "tone": "muted",
                "size": "sm"
              }
            },
            {
              "component": "Table",
              "props": {
                "source": "run.result",
                "selectionBind": "input.selectedFileRefs",
                "rowKey": "row.fileRef",
                "columns": [
                  {
                    "label": "文件",
                    "cells": [
                      {
                        "component": "Text",
                        "props": {
                          "bind": "row.name",
                          "lines": 2
                        }
                      },
                      {
                        "component": "Details",
                        "props": {
                          "label": "路径、结论与来源"
                        },
                        "children": [
                          {
                            "component": "Text",
                            "props": {
                              "bind": "row.path",
                              "size": "sm",
                              "tone": "muted"
                            }
                          },
                          {
                            "component": "Text",
                            "props": {
                              "bind": "row.reason",
                              "size": "sm"
                            }
                          },
                          {
                            "component": "Text",
                            "props": {
                              "bind": "row.sources",
                              "size": "sm",
                              "tone": "muted"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "label": "AI 识别结论",
                    "cells": [
                      {
                        "component": "Text",
                        "props": {
                          "bind": "row.title"
                        }
                      },
                      {
                        "component": "Stack",
                        "props": {
                          "direction": "row",
                          "gap": "sm"
                        },
                        "children": [
                          {
                            "component": "Text",
                            "props": {
                              "bind": "row.year",
                              "tone": "muted"
                            }
                          },
                          {
                            "component": "Text",
                            "props": {
                              "bind": "row.mediaType",
                              "format": "mediaType",
                              "tone": "muted"
                            }
                          }
                        ]
                      },
                      {
                        "component": "Stack",
                        "props": {
                          "direction": "row",
                          "gap": "sm"
                        },
                        "children": [
                          {
                            "component": "Text",
                            "props": {
                              "text": "TMDB",
                              "tone": "muted",
                              "size": "sm"
                            },
                            "visibleWhen": {
                              "path": "row.tmdbId",
                              "op": "truthy"
                            }
                          },
                          {
                            "component": "Text",
                            "props": {
                              "bind": "row.tmdbId",
                              "tone": "muted"
                            }
                          },
                          {
                            "component": "Text",
                            "props": {
                              "bind": "row.seasonEpisode"
                            }
                          }
                        ]
                      },
                      {
                        "component": "Text",
                        "props": {
                          "bind": "row.warning",
                          "size": "sm",
                          "tone": "warning"
                        }
                      }
                    ]
                  },
                  {
                    "label": "整理状态",
                    "cells": [
                      {
                        "component": "Status",
                        "props": {
                          "bind": "row.status"
                        }
                      },
                      {
                        "component": "Text",
                        "props": {
                          "bind": "row.error",
                          "size": "sm",
                          "tone": "danger"
                        }
                      },
                      {
                        "component": "Text",
                        "props": {
                          "text": "已交给 MT，实际进度见下方业务任务。",
                          "tone": "muted",
                          "size": "sm"
                        },
                        "visibleWhen": {
                          "path": "row.taskRef",
                          "op": "truthy"
                        }
                      }
                    ]
                  }
                ]
              }
            },
            {
              "component": "Button",
              "props": {
                "label": "重试所选待处理文件",
                "action": "start",
                "actionId": "retry-pending",
                "variant": "outline"
              },
              "disabledWhen": {
                "path": "ui.working",
                "op": "truthy"
              }
            },
            {
              "component": "Text",
              "props": {
                "text": "跨页选择后重试；已提交及提交结果不明的文件自动排除。停止识别不会撤销已入队的整理，可在业务任务中单独取消。",
                "tone": "muted",
                "size": "sm"
              }
            },
            {
              "component": "RunLog"
            }
          ],
          "visibleWhen": {
            "path": "ui.hasRun",
            "op": "truthy"
          }
        },
        {
          "component": "EmptyState",
          "props": {
            "title": "从一组视频开始",
            "description": "AI 负责识别，MT 按识别参数执行手动整理。每个文件单独对应作品和任务。"
          },
          "visibleWhen": {
            "path": "ui.hasRun",
            "op": "falsy"
          }
        },
        {
          "component": "TaskList"
        }
      ]
    },
    {
      "id": "history",
      "label": "运行记录",
      "content": [
        {
          "component": "RunHistory"
        },
        {
          "component": "TaskList"
        }
      ]
    },
    {
      "id": "settings",
      "label": "插件设置",
      "content": [
        {
          "component": "Card",
          "props": {
            "title": "识别策略由你决定"
          },
          "children": [
            {
              "component": "Text",
              "props": {
                "text": "完整提示词可直接编辑，留空使用插件默认值。不会拼接旧的提取、筛选或复核提示词。定时运行同样会直接整理，请检查授权后再启用。",
                "tone": "muted",
                "size": "sm"
              }
            }
          ]
        },
        {
          "component": "ConfigForm"
        },
        {
          "component": "ScheduleForm"
        },
        {
          "component": "DataManagement"
        }
      ]
    }
  ]
}
